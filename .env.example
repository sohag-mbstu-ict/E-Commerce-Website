DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
# Production (DJANGO_DEBUG=False) refuses to start with the placeholder secret key or
# ALLOWED_HOSTS=*. Example:
# DJANGO_ALLOWED_HOSTS=myshop.com,www.myshop.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://myshop.com,https://www.myshop.com
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=3600

# Database - defaults to SQLite (db.sqlite3). For Postgres (pip install psycopg[binary]):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=myshop
# DB_USER=myshop
# DB_PASSWORD=secret
# DB_HOST=localhost
# DB_PORT=5432

STORE_NAME=MyShop
CURRENCY_SYMBOL=৳
DEFAULT_SHIPPING_FEE=60
FREE_SHIPPING_THRESHOLD=2000

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
